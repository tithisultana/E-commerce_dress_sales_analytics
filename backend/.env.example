# Google Gemini Configuration for E-Commerce Dress Sales Analytics Chatbot
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
# Set your Gemini API key below (Do NOT commit real keys to Git)
GEMINI_API_KEY=your_gemini_api_key_here

# Currently supported fast Gemini model (default: gemini-3.5-flash-lite)
# Other supported options: gemini-3.5-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash-lite

